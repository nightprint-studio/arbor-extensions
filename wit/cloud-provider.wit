package arbor:extensions@1.0.0;

// A cloud object-storage provider: what it takes to make a bucket browsable.
//
// ## Coarse on purpose, and it comes by it honestly
//
// Unlike a format backend, this interface did not have to be reshaped to survive a boundary —
// object storage is already coarse. `list`, `stat`, `read`, `write`: few calls, large
// payloads, every one of them already a network round trip. The cost of the component
// boundary disappears next to the cost of the request it wraps.
//
// ## Whole calls, not a connection
//
// This interface used to open a `connection` resource and hang the operations off it. That
// read well and made the package unreachable: a resource is a handle into one store's memory,
// so it cannot cross a JSON boundary, and the *only* caller that could hold one was Arbor
// itself, calling through generated bindings — which meant Arbor had to carry this contract,
// generate against it, and route to it. Exactly the arrangement that makes a wasm file an
// implementation detail of a built-in rather than an extension. **If the host has to learn
// something, it is not a plugin.**
//
// So every function carries `bucket` and `config` and answers on its own. The cost is that a
// provider re-derives its authentication per call; the fix for that belongs inside the guest,
// which may cache whatever it likes across calls in its own module state — and a token read
// is a host call, not a round trip.
//
// The caller is now the plugin, in Lua, through `arbor.ext.call` — and for the payload-shaped
// ones, `arbor.ext.call_to_file` / `call_from_file`, which move bytes between the guest and a
// local file without them ever becoming JSON.
//
// ## The guest does not hold the credential
//
// A provider asks `arbor:host/secrets` for a token by the key its manifest declared, and it
// asks `arbor:host/http` to perform requests. It never opens a socket and never speaks TLS.
// The host is Arbor's credential broker already; a guest that could hold the token would put
// the enforcement of "only the slots you declared" back into a promise.
interface cloud-types {
  /// One entry in a listing.
  record object {
    /// Full key within the bucket. `a/b/c.txt` — never a local path.
    key: string,
    /// Whether this is a prefix (a "folder") rather than a stored object. Object stores have
    /// no directories; a listing synthesises them, and the explorer needs to know which it
    /// is looking at to decide whether descending is meaningful.
    prefix: bool,
    size: u64,
    /// Unix seconds. `none` when the store does not report one, which several do not for a
    /// synthesised prefix.
    modified: option<u64>,
    /// The store's own version of "this has not changed" — an ETag, a generation number.
    /// Opaque; used only for comparison.
    etag: option<string>,
    content-type: option<string>,
  }

  record listing {
    entries: list<object>,
    /// Opaque continuation. `none` when the listing is complete.
    ///
    /// A cursor rather than a page number because that is what every object store actually
    /// offers, and inventing page numbers on top means holding state the store does not.
    cursor: option<string>,
  }

  /// A byte range, for resuming an interrupted download and for reading a header without
  /// pulling a multi-gigabyte object.
  record range {
    start: u64,
    /// Exclusive. `none` reads to the end.
    end: option<u64>,
  }

  /// Which bucket, and the provider's own configuration for reaching it.
  ///
  /// `config` is opaque to the host — endpoint, region, whichever of them this provider needs
  /// — because the host has no business knowing what an S3 region is; the settings panel that
  /// produced it belongs to the same package. Credentials are NOT in here: the provider
  /// fetches them by key from `arbor:host/secrets`, which is what keeps a token out of a
  /// config file.
  record target {
    bucket: string,
    config: string,
  }

  /// An access token and how long it stays usable.
  ///
  /// `expires-in` is SECONDS FROM NOW rather than a deadline, because a guest has no clock:
  /// the caller has one, and turning a duration into a deadline is the caller's arithmetic.
  record token {
    access-token: string,
    expires-in: u64,
  }

  variant error {
    /// The key does not exist.
    not-found(string),
    /// The store said no. Distinct from `not-found` because the fix is different: one is a
    /// typo, the other is a permission or an expired token.
    denied(string),
    /// The credential is missing, malformed or expired.
    auth(string),
    /// The request reached the store and it failed for another reason. Carries the status
    /// where there was one.
    remote(tuple<option<u16>, string>),
    /// The request could not be made — network down, host not in the allowlist.
    transport(string),
    /// The connection config is not usable.
    config(string),
  }
}

interface cloud-provider {
  use cloud-types.{object, listing, range, target, token, error};

  /// Check the target is usable, for the settings panel's "Test" button. Cheap and
  /// side-effect free — typically a zero-length list.
  test: func(at: target) -> result<_, error>;

  /// One page of a listing under `prefix`.
  ///
  /// `delimiter` set to `/` gives the folder-shaped view the explorer renders; unset walks
  /// everything under the prefix, which is what a search does.
  // `%list`: `list` is a WIT keyword (the built-in `list<T>`), and the escape is what the
  // language provides for exactly this. Renaming it would cost the one word every object
  // store calls this operation.
  %list: func(
    at: target,
    prefix: string,
    delimiter: option<string>,
    cursor: option<string>,
    limit: option<u32>,
  ) -> result<listing, error>;

  /// Metadata for one key, without fetching it.
  stat: func(at: target, key: string) -> result<object, error>;

  /// Read an object, or part of one.
  ///
  /// Returns bytes rather than streaming them. A stream out of a guest is the hardest shape
  /// the component model has, and ranged reads cover what streaming was wanted for: the
  /// caller asks for the slice it can hold. A large download is successive ranged reads,
  /// which `arbor.ext.call_to_file` appends to one file without the bytes passing through the
  /// caller.
  read: func(at: target, key: string, part: option<range>) -> result<list<u8>, error>;

  /// Write an object whole. The caller's side of a chunked upload is
  /// `arbor.ext.call_from_file`, which lowers a slice of a local file into `body`.
  write: func(
    at: target,
    key: string,
    body: list<u8>,
    content-type: option<string>,
  ) -> result<_, error>;

  /// Remove an object. Removing something absent succeeds — the caller asked for it to be
  /// gone, and it is.
  delete: func(at: target, key: string) -> result<_, error>;

  /// Turn a credential the provider understands into an access token.
  ///
  /// The route that needs cryptography: a service-account key is an RSA private key, and the
  /// exchange is a JWT signed with it. It lives in the guest because that is where the
  /// signing code can be — Lua has no RSA, and a host that grew one would be a host that had
  /// learned what a service account is.
  ///
  /// `credential` is the provider's own format, opaque to everyone else (for GCS, the key
  /// file's JSON). The answer is meant to be STORED by the caller, in the same credential slot
  /// the provider reads its bearer token from — which is what keeps this to one exchange per
  /// hour rather than one per request, since every call instantiates a fresh guest.
  ///
  /// `now-secs` is unix time, from the CALLER. A guest has no clock, and an assertion carries
  /// the time it was issued at — so the alternative to passing it is granting every provider a
  /// clock capability for the sake of one field.
  mint-token: func(credential: string, scope: string, now-secs: u64) -> result<token, error>;

  /// Server-side copy, so the bytes never travel through this machine.
  ///
  /// `source`/`destination` rather than `from`/`to`: `from` is a WIT keyword, and a pair of
  /// parameters where one is escaped and the other is not reads worse than naming both.
  copy: func(at: target, source: string, destination: string) -> result<_, error>;
}

/// The world a cloud provider exports.
world cloud-provider-world {
  import secrets;
  import http;
  import log;
  export cloud-provider;
}
